{
  "name": "typing-speed-test",
  "version": "1.0.0",
  "description": "A typing speed test web app with a Postgres-backed leaderboard",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "knex migrate:latest --knexfile knexfile.cjs",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.cjs",
    "migrate:make": "knex migrate:make --knexfile knexfile.cjs -x cjs",
    "seed": "knex seed:run --knexfile knexfile.cjs",
    "test": "playwright test"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "knex": "^3.3.0",
    "pg": "^8.13.1",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
